# JVM Options for Wazuh Indexer (OpenSearch)

# Heap size (50% of RAM, max 31GB)
-Xms{{ indexer_heap_size }}
-Xmx{{ indexer_heap_size }}

# GC Configuration
-XX:+UseG1GC
-XX:G1ReservePercent=25
-XX:InitiatingHeapOccupancyPercent=30

# DNS cache
-Des.networkaddress.cache.ttl=60
-Des.networkaddress.cache.negative.ttl=10

# Security
-Djava.security.policy=/usr/share/wazuh-indexer/plugins/opensearch-security/security.policy

# Log4j
-Dlog4j2.formatMsgNoLookups=true

# Headless mode (no GUI)
-Djava.awt.headless=true

# File encoding
-Dfile.encoding=UTF-8

# JMX (disabled by default)
# -Dcom.sun.management.jmxremote
# -Dcom.sun.management.jmxremote.port=9999
# -Dcom.sun.management.jmxremote.authenticate=false
# -Dcom.sun.management.jmxremote.ssl=false

# GC Logging
-Xlog:gc*,gc+age=trace,safepoint:file=/var/log/wazuh-indexer/gc.log:utctime,pid,tags:filecount=32,filesize=64m

# Heap dump on OOM
-XX:+HeapDumpOnOutOfMemoryError
-XX:HeapDumpPath=/var/log/wazuh-indexer/heapdump.hprof

# Module access (for OpenSearch Security)
--add-opens=java.base/java.security=ALL-UNNAMED
--add-opens=java.base/java.io=ALL-UNNAMED
--add-opens=java.base/java.lang=ALL-UNNAMED
--add-opens=java.base/java.util=ALL-UNNAMED